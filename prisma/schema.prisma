datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  idUsuario      Int      @id @default(autoincrement())
  nombreCompleto String
  correo         String   @unique
  password       String
  rol            String   @default("LECTOR")
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Plantel {
  idPlantel   Int          @id @default(autoincrement())
  nombre      String       @unique
  siglas      String?
  institucion String       @default("UNAM") // Ej. "UNAM", "IPN", "UAM", "UAEMex", "TecNM", "Privada", etc.
  esUnam      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt @default(now())
  expedientes Expediente[]
}

model Carrera {
  idCarrera   Int          @id @default(autoincrement())
  nombre      String       @unique
  expedientes Expediente[]
}

model Coordinador {
  idCoordinador  Int          @id @default(autoincrement())
  nombreCompleto String
  gradoAcademico String       // Ej. "Lic.", "Mtro.", "Dra.", "Ing."
  expedientes    Expediente[]
}

model Expediente {
  idExpediente         Int                   @id @default(autoincrement())
  clave                String                @unique // SS-[NoCuenta]-[Año]
  
  // Datos del Alumno
  nombre               String
  apPaterno            String
  apMaterno            String
  numeroCuenta         String                // 9 dígitos UNAM
  correoElectronico    String
  telefono             String
  edad                 Int
  sexo                 String                // "H", "M", "O"
  semestre             String                // "6to", "7mo", "8vo", etc.
  
  // Datos Académicos
  idPlantel            Int
  plantel              Plantel               @relation(fields: [idPlantel], references: [idPlantel])
  idCarrera            Int
  carrera              Carrera               @relation(fields: [idCarrera], references: [idCarrera])
  
  // Datos del Programa
  tipoPrograma         String                // "SS" | "PP"
  clavePrograma        String                // Clave oficial DGOAE / SIASS
  nombrePrograma       String                // Nombre oficial del programa registrado
  cicloEscolar         String                // "2026-1", "2026-2", etc.
  ubicacionDependencia String                // Sede 1 o Sede 2
  modalidad            String                // "Presencial", "A Distancia", "Mixta"
  turno                String                // "Matutino", "Vespertino", "Mixto"
  
  idCoordinador        Int
  coordinador          Coordinador           @relation(fields: [idCoordinador], references: [idCoordinador])
  
  // Tiempos y Control
  fechaInicio          DateTime
  fechaTentativa       DateTime
  fechaTermino         DateTime?
  estatus              String                @default("Activo") // "Activo", "Terminado", "Declinado"
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  
  seguimiento          SeguimientoDocumental?
}

model SeguimientoDocumental {
  idSeguimiento            Int        @id @default(autoincrement())
  idExpediente             Int        @unique
  expediente               Expediente @relation(fields: [idExpediente], references: [idExpediente], onDelete: Cascade)
  
  // 1. Carta de Presentación
  cartaPresentacionUrl     String?
  cartaPresentacionFolio   String?

  // 2. Carta de Aceptación
  cartaAceptacionUrl       String?
  cartaAceptacionRecogida  Boolean    @default(false)
  cartaAceptacionFolio     String?
  cartaAceptacion          Boolean    @default(false)

  // 3. Informe Final
  informeFinalUrl          String?
  aplicaInformeFinal       Boolean    @default(true)
  informeFinalFolio        String?

  // 4. Carta de Término
  cartaTerminoUrl          String?
  cartaTerminoFolio        String?
  cartaTermino             Boolean    @default(false)

  // Histórico y Observaciones
  preRegistro              DateTime?
  registro                 DateTime?
  declinacionObs           String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
}
